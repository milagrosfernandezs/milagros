# Meta Ads Configuration (REQUIRED)
META_ACCESS_TOKEN=your_facebook_access_token
META_AD_ACCOUNT_ID=act_your_ad_account_id
META_BUSINESS_ACCOUNT_ID=your_business_id

# Automation Settings
DAILY_BUDGET=100
TARGET_ROAS=3.0
MIN_CONVERSION_RATE=0.02
AUTO_OPTIMIZE=true
PORT=3000

# Platform
NODE_ENV=production
